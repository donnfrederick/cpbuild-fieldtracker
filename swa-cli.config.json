{
  "$schema": "https://aka.ms/azure/static-web-apps-cli/schema",
  "configurations": {
    "cpb-tools-dashboard": {
      "appLocation": ".",
      "apiLocation": "api",
      "outputLocation": "dist",
      "apiLanguage": "node",
      "apiVersion": "16",
      "appBuildCommand": "npm run build",
      "apiBuildCommand": "npm run build --if-present",
      "run": "npm run vue",
      "appDevserverUrl": "http://localhost:5173",
      "appName": "cpb-tools-dashboard-local",
      "auth": "emulator",
      "resourceGroup": "cpb-tools-dashboard-local-rg"
    },
    "cpb-tools-dashboard-local-swa": {
      "appLocation": ".",
      "apiLocation": "api",
      "outputLocation": "dist",
      "apiLanguage": "node",
      "apiVersion": "16",
      "appBuildCommand": "npm run build",
      "apiBuildCommand": "npm run build --if-present",
      "run": "npm run dev",
      "auth": "emulator",
      "appDevserverUrl": "http://localhost:5173"
    }
  }
}
