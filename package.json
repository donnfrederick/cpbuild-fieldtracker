{
  "name": "cpb-tools-dashboard",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "vue": "vite",
    "local-swa": "swa start dist --api-location api",
    "build": "run-p type-check build-only",
    "build:prod-check": "VITE_APP_ENV=prod vite build",
    "preview": "vite preview",
    "vitest-ui": "vitest --ui",
    "test": "vitest",
    "type-check:test": "vue-tsc --noEmit -p tsconfig.vitest.json",
    "type-check:deploy": "vue-tsc --noEmit -p tsconfig.prod.json",
    "coverage": "vitest run --coverage.enabled true --coverage.provider=c8",
    "test:coverage": "vitest run --coverage.enabled true --coverage.provider=c8",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.typecheck.json --composite false",
    "type-check:prod": "vue-tsc --noEmit -p tsconfig.prod.json --composite false",
    "lint": "eslint . --ext .vue,.ts,.js",
    "lint:fix": "eslint . --ext .vue,.ts,.js --fix",
    "lint:ci": "eslint . --ext .vue,.ts,.js --max-warnings=0",
    "format": "prettier --write src/",
    "watch": "onchange '**/*.vue' '**/*.js' '**/*.ts' '**/*.css' '!dist/**/*' '!api/dist/**/*' -- npm run build-only",
    "restart-api": "swa start dist --api-location api --verbose & npm run watch",
    "start": "cd api && npm run build && cd .. && npm run build-only && npm run local-swa & npm run watch",
    "nswag": "nswag run /runtime:Net100 && npx tsx src/shared/service-proxies/injectBaseApiClientImport.ts"
  },
  "dependencies": {
    "@azure/msal-browser": "^3.1.0",
    "@fancyapps/ui": "^5.0.36",
    "@microsoft/signalr": "^9.0.6",
    "@popperjs/core": "^2.11.8",
    "axios": "^1.6.0",
    "axios-retry": "^4.1.0",
    "bootstrap": "^5.3.0",
    "bootstrap-icons": "^1.10.5",
    "cookie": "^0.7.0",
    "dexie": "^4.0.11",
    "fabric": "^6.5.4",
    "filepond": "^4.32.5",
    "filepond-plugin-file-validate-size": "^2.2.8",
    "filepond-plugin-file-validate-type": "^1.2.9",
    "filepond-plugin-image-crop": "^2.0.6",
    "filepond-plugin-image-edit": "^1.6.3",
    "filepond-plugin-image-exif-orientation": "^1.0.11",
    "filepond-plugin-image-preview": "^4.6.12",
    "filepond-plugin-image-resize": "^2.0.10",
    "filepond-plugin-image-transform": "^3.8.7",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.1",
    "logrocket": "^9.0.2",
    "pinia": "^2.0.36",
    "posthog-js": "^1.249.3",
    "tabulator-tables": "6.2",
    "uuid": "^11.0.3",
    "vee-validate": "^4.5.8",
    "vue": "^3.3.2",
    "vue-filepond": "^7.0.4",
    "vue-router": "^4.2.0",
    "vue-select": "^4.0.0-beta.6",
    "yup": "^1.3.2"
  },
  "devDependencies": {
    "@azure/static-web-apps-cli": "2.0.2",
    "@pinia/testing": "^0.1.7",
    "@rushstack/eslint-patch": "^1.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@tsconfig/node18": "^2.0.1",
    "@types/bootstrap": "^5.2.6",
    "@types/cookie": "^0.5.2",
    "@types/fabric": "^5.3.9",
    "@types/jsdom": "^21.1.1",
    "@types/jsonwebtoken": "^9.0.3",
    "@types/node": "^18.16.8",
    "@types/tabulator-tables": "^6.2.0",
    "@types/vue-select": "^3.16.7",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-vue": "^4.6.2",
    "@vitest/coverage-c8": "^0.32.4",
    "@vitest/ui": "^0.32.0",
    "@vue/eslint-config-prettier": "^7.1.0",
    "@vue/eslint-config-typescript": "^11.0.3",
    "@vue/test-utils": "^2.3.2",
    "@vue/tsconfig": "^0.4.0",
    "concurrently": "^8.1.0",
    "dotenv": "^16.3.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^22.0.0",
    "npm-force-resolutions": "^0.0.10",
    "npm-run-all": "^4.1.5",
    "nswag": "^14.6.2",
    "onchange": "^7.1.0",
    "prettier": "^2.8.8",
    "rollup-plugin-visualizer": "^5.9.2",
    "typescript": "~5.0.4",
    "vite": "^4.5.5",
    "vitest": "^0.32.4",
    "vue-eslint-parser": "^10.1.3",
    "vue-tsc": "^1.6.5"
  },
  "resolutions": {
    "got": "11.8.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}